# music-diatonic (Hackage, BSD3), for the Haskell example (examples/haskell):
# its sources only, which the parent project compiles with ghc into a module
# library, with the export module.
project('music-diatonic', version: '0.1.2', license: 'BSD-3-Clause', meson_version: '>=0.61')

sources = files(
  'Music/Diatonic.hs',
  'Music/Diatonic/Chord.hs',
  'Music/Diatonic/Degree.hs',
  'Music/Diatonic/Equivalence.hs',
  'Music/Diatonic/Harmony.hs',
  'Music/Diatonic/Interval.hs',
  'Music/Diatonic/Key.hs',
  'Music/Diatonic/Note.hs',
  'Music/Diatonic/Quality.hs',
  'Music/Diatonic/Scale.hs',
)
