# Meson build directories (meson setup build)
/build*/
/_build*/

# In-source build products, in case anything compiles in the tree
*.o
*.so
*.so.*
*.a
# ghc's foreign-export stubs, when a module library is built without -stubdir
*_stub.h

# C# builds outside Meson (an editor's C# extension, a plain dotnet build):
# Directory.Build.props sends them here. Meson builds Ugly.dll and the C#
# fixtures in the build directory.
/.artifacts/
# ...and where they went before it, beside each project.
/plugins/dotnet/bin/
/plugins/dotnet/obj/
/tests/dotnet/bin/
/tests/dotnet/obj/

# Editors
*~
*.swp

# Meson subprojects: downloaded sources and their cache (the .wrap files and
# packagefiles/ are ours)
/subprojects/*/
!/subprojects/packagefiles/
/subprojects/packagecache/
__pycache__/

# Scratch space for small programs and experiments, never committed
/stuff/
