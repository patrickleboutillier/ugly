<!-- The .NET binding's test: a plain .NET program referencing Ugly.dll (-p:UglyDll=...), as any program using UGLY would. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>test_binding</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Ugly">
      <HintPath>$(UglyDll)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
