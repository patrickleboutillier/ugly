# Valgrind suppressions for the test setup (meson test --setup valgrind).
#
# CPython is initialized once per process and never finalized (see
# plugins/python/python.c), so its live objects are still allocated at exit.
# Its GC-tracked objects are reached through tagged/offset pointers in the
# collector's lists, so memcheck reports them as "possibly lost". Only that
# kind is suppressed: memory errors and definite or indirect leaks still fail,
# in the Python plugin as everywhere else. (Valgrind can't tell a refcount
# leak in the plugin from Python's own live objects; the conformance suite's
# finalized() checks cover that instead.)
{
   cpython-live-objects-possibly-lost
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   obj:*/libpython3*.so*
}
# The same, when CPython is the host (tests/python/test_binding.py): the
# python3 executable is statically linked, so the frames are in it rather
# than in libpython.
{
   cpython-host-live-objects-possibly-lost
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   obj:*/bin/python3*
}
# Python 3.12 as the host (tests/python/test_binding.py under python3.12):
# the interpreter finalizes, but 3.12's interned strings are immortal and
# never freed (3.13 frees them again), so the strings it interned at startup,
# at imports and for attribute names show up as "definitely lost". Every
# such block is allocated directly by the python3.12 executable; UGLY's own
# allocations start in libugly or a plugin and stay checked. Found by CI on
# Ubuntu 24.04.
{
   cpython312-host-immortal-interned-strings
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   obj:*/bin/python3.12
}
# GHC's RTS (plugins/haskell) is started once per process and never stopped
# (hs_exit can't be undone), so its threads (the timer, the IO manager, the
# workers) are still running at exit, and their stacks and thread-local
# storage show up as "possibly lost". Only that kind, and only for blocks
# allocated under the RTS.
{
   ghc-rts-live-threads-possibly-lost
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   obj:*/libHSrts*.so*
}
